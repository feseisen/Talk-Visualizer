{
  "manifest_version": 3,
  "name": "kiku 橋（画面共有の音を枠へ）",
  "version": "0.2.2",
  "description": "claude.ai の親ページで画面共有の音（PC で鳴っている会議の音）をブラウザの音声認識で文字にし、kiku のアーティファクトの枠へ postMessage で流す。この拡張は通信しない。",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "all_frames": false,
      "js": [
        "intake.js",
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
